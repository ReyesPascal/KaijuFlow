{
  "name": "usenet-ultimate",
  "version": "1.4.1",
  "description": "Modern Usenet streaming addon for Stremio",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:unit": "node --import tsx --test --test-force-exit tests/unit/*.test.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "check:brain": "bash tools/brain/check.sh",
    "test:integration": "npm run build && bash tests/integration/run-ci.sh",
    "test:a4": "npm run build && bash scripts/prepare-a4-hook.sh && bash tests/a4/run-ci.sh",
    "release:patch": "bash release.sh patch",
    "release:minor": "bash release.sh minor",
    "release:major": "bash release.sh major",
    "docker:clean": "bash scripts/docker-clean.sh"
  },
  "keywords": [
    "stremio",
    "addon",
    "usenet",
    "nzb"
  ],
  "author": "DSmart33",
  "license": "MIT",
  "dependencies": {
    "@viren070/parse-torrent-title": "^0.6.7",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "stremio-addon-sdk": "^1.6.10",
    "uuid": "^13.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.5",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
